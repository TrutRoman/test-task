<%- include("partials/header") %>

<section class="page-head">
  <p class="eyebrow">Обліковий запис</p>
  <h1>Реєстрація</h1>
  <p class="lead">Створіть обліковий запис, щоб отримати доступ до особистого кабінету.</p>
</section>

<section class="split split-form">
  <div class="card">
    <% if (errors.length > 0) { %>
      <ul class="alert">
        <% errors.forEach((error) => { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    <% } %>

    <form method="post" action="/register" class="form" id="register-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <label for="email">Email</label>
      <input id="email" name="email" type="email" value="<%= email %>" required autocomplete="email">

      <label for="name">Ім'я</label>
      <input id="name" name="name" type="text" value="<%= name %>" required
             minlength="<%= rules.nameMin %>" maxlength="<%= rules.nameMax %>" autocomplete="name">

      <label for="password">Пароль</label>
      <input id="password" name="password" type="password" required
             minlength="<%= rules.passwordMin %>" autocomplete="new-password">

      <button type="submit" class="button">Зареєструватися</button>
    </form>

    <p class="form-switch">Уже маєте акаунт? <a href="/login">Увійти</a></p>
  </div>

  <aside class="card card-soft">
    <h2>Вимоги до даних</h2>
    <ul class="requirements" id="requirements"
        data-email-pattern="<%= rules.emailPattern %>"
        data-name-min="<%= rules.nameMin %>"
        data-name-max="<%= rules.nameMax %>"
        data-password-min="<%= rules.passwordMin %>">
      <li data-field="email">Email у форматі name@example.com</li>
      <li data-field="name">Ім'я — <%= rules.nameMin %>–<%= rules.nameMax %> символів</li>
      <li data-field="password">Пароль — від <%= rules.passwordMin %> символів</li>
    </ul>
  </aside>
</section>

<script src="/register.js" defer></script>

<%- include("partials/footer") %>
