<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · WebTest</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/style.css">
  <%# Тема ставиться до першого малювання сторінки, щоб не було спалаху світлої теми %>
  <script>
    document.documentElement.dataset.theme = localStorage.getItem("theme")
      ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
  </script>
  <script src="/theme.js" defer></script>
</head>
<body>
<div class="shell">
  <aside class="sidebar">
    <a class="brand" href="/">
      <span class="brand-mark">&lt;/&gt;</span>
      <span class="brand-text">
        <strong>WebTest</strong>
        <small>IT-школа</small>
      </span>
    </a>

    <nav class="side-nav">
      <a href="/" class="side-link<%= locals.currentPath === "/" ? " is-active" : "" %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
        Головна
      </a>
      <a href="/courses" class="side-link<%= locals.currentPath === "/courses" ? " is-active" : "" %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h13v15H6a2 2 0 0 0-2 2z"/><path d="M4 20a2 2 0 0 0 2 2h13v-4"/></svg>
        Курси
        <% if (!locals.user) { %>
          <svg class="side-lock" viewBox="0 0 24 24" aria-label="Потрібна реєстрація"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
        <% } %>
      </a>
      <a href="/profile" class="side-link<%= locals.currentPath === "/profile" ? " is-active" : "" %>">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        Особистий кабінет
        <% if (!locals.user) { %>
          <svg class="side-lock" viewBox="0 0 24 24" aria-label="Потрібен вхід"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
        <% } %>
      </a>
      <% if (locals.user && locals.user.role === "admin") { %>
        <a href="/admin" class="side-link<%= locals.currentPath === "/admin" ? " is-active" : "" %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg>
          Адмін-панель
        </a>
      <% } %>
    </nav>
  </aside>

  <div class="workspace">
    <header class="topbar">
      <p class="topbar-tagline">WebTest — твоя база знань</p>
      <div class="account">
        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Перемкнути тему" title="Перемкнути тему">
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <% if (locals.user) { %>
          <div class="user-chip">
            <span class="avatar<%= locals.user.role === "admin" ? " avatar-admin" : "" %>"><%= initials(locals.user.name) %></span>
            <span class="user-meta">
              <strong><%= locals.user.name %></strong>
              <small><%= roleLabel(locals.user.role) %></small>
            </span>
          </div>
          <form method="post" action="/logout" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="button button-secondary button-small">Вийти</button>
          </form>
        <% } else { %>
          <div class="user-chip user-chip-guest">
            <span class="avatar avatar-guest">?</span>
            <span class="user-meta">
              <strong>Гість</strong>
              <small>Не авторизовано</small>
            </span>
          </div>
          <a href="/login" class="button button-secondary button-small">Увійти</a>
          <a href="/register" class="button button-small">Реєстрація</a>
        <% } %>
      </div>
    </header>

    <main class="content">
